# ローカル開発用。`.dev.vars` にコピーして使う（gitignore 済み）。
# Keyway を使う場合: keyway pull -e development -f .dev.vars -y
#
# ローカルには Cloudflare Access が無いため、ENVIRONMENT=development のときだけ
# DEV_IDENTITY_EMAIL を認証済み利用者として扱う。本番では必ず無効。

ENVIRONMENT=development
DEV_IDENTITY_EMAIL=owner@example.com
ACCESS_ALLOWED_EMAILS=owner@example.com,partner@example.com
# email:表示名:Mantineの色名 をカンマ区切り
MEMBERS=owner@example.com:甲:teal,partner@example.com:乙:pink

# 本番でのみ使う値（ローカルでは空でよい）
ACCESS_TEAM_DOMAIN=
ACCESS_POLICY_AUD=

# Google マップ（地図タブ）。Maps JavaScript API のキー（HTTP リファラー制限つき・README「Google マップ」）。
# 空なら地図の代わりに案内文が出る。Map ID は省略可（省略時は Google のサンプル用 DEMO_MAP_ID）
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# メール取込（設計 2026-09-19 §7）の転送先アドレス。**secret** にする
# （推測できないアドレスであること自体が偽装への緩和策。public リポジトリに置かない）。
# ランダムな local part を推奨、例 news-a1b2c3d4@sumai-log.app
# 本番は `printf '%s' '<そのアドレス>' | npx wrangler secret put MAIL_INBOX_ADDRESS`。
# 空なら設定ページに「未設定」と出るだけで、受信そのものには影響しない。
MAIL_INBOX_ADDRESS=
