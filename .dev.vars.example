# For local development. Copy to `.dev.vars` to use it (already gitignored).
# With Keyway: keyway pull -e development -f .dev.vars -y
#
# There is no Cloudflare Access locally, so DEV_IDENTITY_EMAIL is treated as the
# authenticated user only when ENVIRONMENT=development. Always disabled in production.

ENVIRONMENT=development
DEV_IDENTITY_EMAIL=owner@example.com
ACCESS_ALLOWED_EMAILS=owner@example.com,partner@example.com
# email:display name:Mantine color name, comma separated
MEMBERS=owner@example.com:甲:teal,partner@example.com:乙:pink

# Values used only in production (may stay empty locally)
ACCESS_TEAM_DOMAIN=
ACCESS_POLICY_AUD=

# Google Maps (map tab). Maps JavaScript API key (with HTTP referrer restriction; see the
# README section "Google マップ" (Google Maps)).
# If empty, a guidance message is shown instead of the map. Map ID is optional (when omitted,
# Google's sample DEMO_MAP_ID is used)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Forwarding destination address for mail import (design 2026-09-19 §7). Make it a **secret**
# (an unguessable address is itself a mitigation against spoofing. Do not put it in the
# public repository).
# A random local part is recommended, e.g. news-a1b2c3d4@sumai-log.app
# In production: `printf '%s' '<that address>' | npx wrangler secret put MAIL_INBOX_ADDRESS`.
# If empty, the settings page only shows "未設定" (Not set); receiving itself is not affected.
# Forwarding-source Gmail addresses accepted for mail import (allowed in addition to the
# login allowlist. Comma separated)
MAIL_ALLOWED_SENDERS=
MAIL_INBOX_ADDRESS=
# YouTube Data API key (videos.list / playlistItems.list only; restrict it to the YouTube Data
# API v3 in the Google Cloud console). Used by `npm run import:channel-videos` for the published
# dates and by the daily Cron for new channel videos.
# In production: `printf '%s' '<key>' | npx wrangler secret put YOUTUBE_API_KEY`.
# If empty, the Cron skips the refresh.
YOUTUBE_API_KEY=
