#!/bin/sh
# Check that no real data is mixed into the commit.
#
# Writing the rule in AGENTS.md alone did not protect us: real names, real addresses and
# real lot numbers got into comments and test fixtures, and the history had to be rebuilt.
# Do not rely on human attention.
#
# Only the index content is checked (what actually goes into the commit). Takes about 0.2 s.
# If you really must get through: git commit --no-verify.
#
# This hook lives in .githooks/ and is committed. It is enabled by the prepare script that
# runs on npm install (it points core.hooksPath here).

node scripts/check-pii.mjs --staged || {
  echo ''
  echo 'コミットを中止しました。実データは seed.local.json 経由でのみ入れます。'
  echo '（意図して通す場合のみ: git commit --no-verify）'
  exit 1
}
