{
  "name": "sumai-log",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run && vitest run --config vitest.workers.config.ts && vitest run --config vitest.ui.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:server": "vitest run --config vitest.workers.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts --coverage",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pii": "node scripts/check-pii.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sumai-log --local",
    "db:migrate:remote": "wrangler d1 migrations apply sumai-log --remote",
    "db:export": "wrangler d1 export sumai-log --remote --output backups/sumai-log-$(date +%Y%m%d).sql",
    "db:restore:local": "node scripts/db-restore-local.mjs",
    "backup": "node scripts/backup.mjs",
    "import:seed": "node scripts/import-seed.mjs",
    "import:mbox": "tsx scripts/import-mbox.ts",
    "import:works": "tsx scripts/import-works.ts",
    "import:channel-videos": "tsx scripts/import-channel-videos.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/form": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@mantine/schedule": "9.6.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.41",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "postal-mime": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.131.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "sharp": "^0.35.4",
    "miniflare": {
      "undici": "7.30.0"
    }
  }
}
