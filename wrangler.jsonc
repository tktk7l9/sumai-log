/**
 * sumai-log — Cloudflare Workers 設定
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sumai-log",
  // 2026-08-22 に固定: @cloudflare/vitest-pool-workers@0.22.0（最新）が内部で
  // ロックしている workerd@1.20260815.1 が対応する最新日付がこれ。
  // これより先の日付にすると `npm run test:server`（実 D1 のテスト）が
  // ランタイム起動時エラーで即死する（Task 2 で発覚）。
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // 自前のエントリ（Cron の scheduled ハンドラを足すため）。中身は
  // @tanstack/react-start/server-entry の既定エクスポートと同じ fetch を使う。
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // カスタムドメイン。2026-09-16 に所有者がダッシュボードでアタッチ済み。ここに書くのは
  // 設定を後追いで揃えるため（実体は既にダッシュボード側にある）。既定の workers.dev
  // ホストもそのまま生きる（Access アプリは両方のホスト名をカバーする設定）。
  "routes": [{ "pattern": "sumai-log.app", "custom_domain": true }],

  // 毎朝 6 時（JST）に業者のお知らせを取得する（design.md §1）。
  "triggers": { "crons": ["0 21 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sumai-log",
      // Task 10 で `wrangler d1 create sumai-log` を実行して置き換え済み
      "database_id": "607a2569-fecb-45a4-a0eb-a60e8784096a",
      "migrations_dir": "drizzle/migrations",
    },
  ],

  /** 写真（Phase 2）。公開バケットにしない。配信は認証後に Worker 経由 */
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "sumai-log-photos" }],

  /**
   * 既定を production にして、設定漏れは必ず「拒否」側に倒す。
   * ACCESS_TEAM_DOMAIN / ACCESS_POLICY_AUD は非秘密（Task 10 で Access アプリ作成時の値に置き換え済み）。
   * ACCESS_ALLOWED_EMAILS と MEMBERS は secret（`wrangler secret put`）。ここに書かない。
   */
  "vars": {
    "ENVIRONMENT": "production",
    // Task 10 で作成した Access アプリ（Zero Trust API 経由）の値。AUD は公開識別子。
    "ACCESS_TEAM_DOMAIN": "https://odd-bush-1f0d.cloudflareaccess.com",
    "ACCESS_POLICY_AUD": "5635dc6786c82c3d06c1e7942ae8a9e80b275acdd127e85fc3be3bec23300ba3", // gitleaks:allow（秘密でない公開識別子。Access アプリの AUD tag）
  },
}
